<Window x:Class="ClassLibrary9.Views.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClassLibrary9.Views"
             xmlns:ViewModel="clr-namespace:ClassLibrary9.ViewModels"           
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="500" Foreground="White" Background="#FFEBAAAA"
        Width="500" 
        Height="750">
    <Grid Background="White" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="240" MinHeight="0"/>
            <RowDefinition Height="120" MinHeight="0"/>

        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap" Text="Анализ геометрии стены" Grid.Row="0" FontSize="14" Foreground="#FF0A0101" HorizontalAlignment="Center" VerticalAlignment="Center"  />
        <Button Grid.Row="1" Content="Выбрать стену"  Command="{Binding CalcOpening}" Margin="150,5,150,15" Height="20" Width="150" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.201"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>



        <Border Grid.Row="2"
                CornerRadius="5" 
                Padding="10,10,10,10" Margin="10,10,10,10" BorderBrush="#FF7E3030" BorderThickness="1,1,1,1">


            <Grid  Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <TextBlock HorizontalAlignment="Left" Margin="56,0,0,0" TextWrapping="Wrap"  VerticalAlignment="Center" Foreground="Black"
                       Text="{Binding OpeningInfo.WallName, StringFormat='Имя семейства: {0}'}" Grid.Row="0"/>
                <TextBlock HorizontalAlignment="Left" Margin="56,0,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding OpeningInfo.WallType, StringFormat='Имя стены: {0}'}" Foreground="Black" />
            </Grid>

        </Border>
        <Border Grid.Row="3 "
             CornerRadius="5" 
             Padding="10,10,10,10" Margin="10,10,10,10" BorderBrush="#FF7E3030" BorderThickness="1,1,1,1">

            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition  Width="100"/>
                    <ColumnDefinition  Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Left" Margin="30,0,0,0" TextWrapping="Wrap" Text="Длина" VerticalAlignment="Center" Foreground="Black"/>
                <TextBlock HorizontalAlignment="Left" Margin="30,0,0,0" TextWrapping="Wrap" Text="Высота" VerticalAlignment="Center" Foreground="Black" Grid.Row="1"/>
                <TextBlock HorizontalAlignment="Left" Margin="30,0,0,0" TextWrapping="Wrap" Text="Толщина" VerticalAlignment="Center" Foreground="Black" Grid.Row="2"/>
                <TextBlock HorizontalAlignment="Left" Margin="30,10,0,0" TextWrapping="Wrap" Text="Объем" VerticalAlignment="Top" Foreground="Black" Grid.Row="3"/>
                <TextBlock HorizontalAlignment="Left" Margin="30,10,0,0" TextWrapping="Wrap" Text="Площадь" VerticalAlignment="Top" Foreground="Black" Grid.Row="4"/>
                <TextBlock HorizontalAlignment="Left" Margin="132,15,0,0" TextWrapping="Wrap" Text="{Binding OpeningInfo.Lenght, StringFormat={}{0}}" VerticalAlignment="Top" Foreground="Black" Grid.Column="1"/>
                <TextBlock HorizontalAlignment="Left" Margin="132,15,0,0" TextWrapping="Wrap" Text="{Binding OpeningInfo.Height, StringFormat={}{0}}" VerticalAlignment="Top" Foreground="Black" Grid.Row="1" Grid.Column="1"/>
                <TextBlock HorizontalAlignment="Left" Margin="132,15,0,0" TextWrapping="Wrap" Text="{Binding OpeningInfo.Thickness, StringFormat={}{0}}" VerticalAlignment="Top" Foreground="Black" Grid.Row="2" Grid.Column="1"/>
                <TextBlock HorizontalAlignment="Left" Margin="132,0,0,0" TextWrapping="Wrap" Text="{Binding OpeningInfo.Volume, StringFormat={}{0}}" VerticalAlignment="Center" Foreground="Black" Grid.Row="3" Grid.Column="1"/>
                <TextBlock HorizontalAlignment="Left" Margin="132,0,0,0" TextWrapping="Wrap" Text="{Binding OpeningInfo.Area, StringFormat={}{0}}" VerticalAlignment="Center" Foreground="Black" Grid.Row="4" Grid.Column="1"/>

            </Grid>

        </Border>

        <Border Grid.Row="4 "
         CornerRadius="5" 
Padding="10,10,10,10" Margin="10,10,10,10" BorderBrush="#FF7E3030" BorderThickness="1,1,1,1">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EFF2F7" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OpeningInfo.IsCorrect}" Value="True">
                            <Setter Property="Background" Value="#DFF4E0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OpeningInfo.IsCorrect}" Value="False">
                            <Setter Property="Background" Value="#F9DDDD" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>



            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- Первая сетка -->
                <Grid Grid.Row="0" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="64,10,0,2" TextWrapping="Wrap" Width="120"
                              Text="{Binding Limit}"/>
                    <TextBlock HorizontalAlignment="Center" Margin="0,11,0,0" TextWrapping="Wrap" Text="Предел толщины" VerticalAlignment="Top" Foreground="Black" Width="116" RenderTransformOrigin="0.549,1.229"/>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition  Width="150"/>
                        <ColumnDefinition  Width="Auto"/>
                    </Grid.ColumnDefinitions>

                </Grid>
                <!-- Вторая сетка -->
                <Grid Grid.Row="1" ShowGridLines="True">


                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" HorizontalAlignment="Left" Margin="208,0,0,0" Foreground="Black" >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Text" Value="-" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OpeningInfo.IsCorrect}" Value="True">
                                        <Setter Property="Text" Value="Соответствует" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OpeningInfo.IsCorrect}" Value="False">
                                        <Setter Property="Text" Value="Превышает" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>



                </Grid>
            </Grid>


        </Border>
        <TextBlock TextWrapping="Wrap" Text="Информация о стене" Foreground="#FF0A0101" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="23,0,0,0" Grid.Row="2" Background="White" Padding="5,0,5,0" UseLayoutRounding="True"  />
        <TextBlock TextWrapping="Wrap" Text="Геометрические размеры" Foreground="#FF0A0101" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="23,0,0,0" Grid.Row="3" Background="White" Padding="5,0,5,0" UseLayoutRounding="True"  />
        <TextBlock TextWrapping="Wrap" Text="Контроль толщины" Foreground="#FF0A0101" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="23,0,0,0" Grid.Row="4" Background="White" Padding="5,0,5,0" UseLayoutRounding="True"  />
        <!--<TextBox HorizontalAlignment="Left" Margin="249,29,0,0" Grid.Row="4" TextWrapping="Wrap" Text="{Binding OpeningInfo.Limit, StringFormat={}{0}}" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="41,31,0,0" Grid.Row="4" TextWrapping="Wrap" Text="Предел толщины" VerticalAlignment="Top" RenderTransformOrigin="0.123,-0.557" Foreground="Black"/>-->

    </Grid>

</Window>
